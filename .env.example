# Local development defaults are safe without this file. Set these in your hosting dashboard for production.
DJANGO_SECRET_KEY=replace-with-a-unique-50-plus-character-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.example

# Optional: enables hosted AI; without it, AI Studio uses the built-in local helper.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_REQUEST_LIMIT=20

# Required for multi-instance real-time chat. Omit locally to use the in-memory channel layer.
REDIS_URL=redis://localhost:6379/0

# Email — configure for production. In development emails are printed to the console.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=StudySphere <noreply@studysphere.example>
